# Environment Variables Template
# Copy this file to .env.local and fill in your values.
# At minimum, the three Supabase variables and one LLM key are required to run the app.

# ─── Supabase Database + Auth (REQUIRED) ────────────────────────────────────
# The app is not usable without Supabase — it provides auth, persistence, and RLS.
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only. Used for admin access (calendar token store, seed script). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── AI Model ───────────────────────────────────────────────────────────────
# Google Gemini 2.5 Flash — primary LLM (free-tier key from Google AI Studio).
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# OpenAI GPT-4o — optional fallback LLM and used for call summaries.
# OPENAI_API_KEY=your_openai_api_key

# ─── Voice: ElevenLabs TTS ──────────────────────────────────────────────────
# Text-to-speech for voice output (free: 10,000 chars/month).
# Get from: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_HINDI_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ─── Voice: Deepgram STT ────────────────────────────────────────────────────
# Speech-to-text for microphone input (free $200 credit on signup).
# Get from: https://deepgram.com → Console → Create API Key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ─── Google Calendar OAuth2 (per-business appointment booking) ──────────────
# Without these, calendar tools return clearly-flagged simulated results.
# Get from: https://console.cloud.google.com → APIs → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Encrypts stored Google Calendar tokens at rest (AES-256-GCM).
# MUST be 32 bytes as 64 hex chars. Generate with: openssl rand -hex 32
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=your_64_hex_char_key

# HMAC secret for signing the OAuth `state` parameter (binds callback to user+business).
# Falls back to INTEGRATION_CREDENTIALS_ENCRYPTION_KEY, then NEXTAUTH_SECRET.
# REQUIRED in production (signing refuses to use a dev default there).
GOOGLE_OAUTH_STATE_SECRET=your_random_secret_min_32_chars

# ─── Dev Seeding ─────────────────────────────────────────────────────────────
# Auth user UUID that `npm run seed` assigns the demo businesses/workflows to.
# Find it in Supabase → Authentication → Users after signing up.
# SEED_USER_ID=your_auth_user_uuid

# ─── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_random_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000
