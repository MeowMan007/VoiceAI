# Environment Variables Template
# Copy this file to .env.local and fill in your values

# ─── Supabase Database ──────────────────────────────────────────────────────
# Get from: https://supabase.com → Your Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ─── AI Model ───────────────────────────────────────────────────────────────
# OpenAI (recommended — GPT-4o with tool calling)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Google Gemini (alternative / fallback)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# ─── Voice: ElevenLabs TTS ──────────────────────────────────────────────────
# Text-to-speech for voice output (free: 10,000 chars/month)
# Get from: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_HINDI_VOICE_ID=pNInz6obpgDQGcFmaJgB

# ─── Voice: Deepgram STT ────────────────────────────────────────────────────
# Speech-to-text for microphone input (free $200 credit on signup)
# Get from: https://deepgram.com → Console → Create API Key
DEEPGRAM_API_KEY=your_deepgram_api_key

# ─── Google Calendar OAuth2 ─────────────────────────────────────────────────
# For real Calendar integration (mock works without these)
# Get from: https://console.cloud.google.com → APIs → OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_random_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000
